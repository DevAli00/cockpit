# Copy to .env (or run ./scripts/init-env.sh, which writes it with random secrets).
# Never commit .env.
POSTGRES_PASSWORD=change-me-alphanumeric-only
COCKPIT_SECRET_KEY=change-me-at-least-32-random-chars
COCKPIT_ADMIN_EMAIL=you@example.com
COCKPIT_ADMIN_PASSWORD=change-me-min-10-chars
# Set to true only if you serve Cockpit over HTTPS (reverse proxy / Tailscale serve).
COCKPIT_COOKIE_SECURE=false
# Host port the web UI is published on.
COCKPIT_PORT=8080
